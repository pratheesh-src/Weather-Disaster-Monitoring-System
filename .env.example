# TELEGRAM Configuration
# Get your bot token from BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram Chat ID (where alerts will be sent)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Alert settings
ALERTS_ENABLED=true
ALERT_COOLDOWN_SEC=900

# ──────────────────────────────────────────────────────────────
# ⚠️ NEVER commit actual API keys — use .env for secrets only ⚠️
# ──────────────────────────────────────────────────────────────

# Gemini API (for disaster safety RAG)
# Get from: https://ai.google.dev/api/python
GEMINI_API_KEY=your_gemini_api_key_here

# Python Predictor Backend (if running on different host)
PYTHON_PREDICTOR_API=http://127.0.0.1:5001/api/prediction/latest
